# The production value lives in .env.production (committed, applied by `vite build`).
# Copy this to .env.local only to override it on your own machine or per-deployment;
# on Vercel you can also set it under Project Settings -> Environment Variables.
#
# When set, the sign-in screen no longer asks for the API base URL.
# Unset in local dev -> falls back to http://127.0.0.1:8100.
VITE_API_BASE_URL=https://midas-production-5000.up.railway.app
