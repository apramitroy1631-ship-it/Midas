# Copy to .env.local for local overrides. On Vercel, set this in Project Settings ->
# Environment Variables, then redeploy (Vite bakes it in at build time).
#
# When set, the sign-in screen no longer asks for the API base URL.
# Leave unset for local dev - it falls back to http://127.0.0.1:8100.
VITE_API_BASE_URL=https://midas-production-5000.up.railway.app
