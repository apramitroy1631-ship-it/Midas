# Copy to .env and fill in. Never commit the real .env.

APP_NAME="MIDAS - Marketing Intelligence & Decision Automation System"

# Master key for provisioning tenants (POST /v1/admin/tenants). Change this.
ADMIN_API_KEY="midas-admin-change-me"

# --- LLM ---
OPENAI_API_KEY=""
OPENAI_MODEL_DEFAULT="gpt-4o-mini"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_DEFAULT="claude-sonnet-5"

GEMINI_API_KEY=""
GEMINI_MODEL_DEFAULT="gemini-1.5-flash"

GROQ_API_KEY=""
GROQ_MODEL_DEFAULT="openai/gpt-oss-120b"

# AGENT_MODEL_MAP (app/core/config.py) routes every agent already —
# this only needs changing away from "simulator" to actually call it. Any
# other value works since the per-agent map wins; this is just the fallback.
LLM_PROVIDER="simulator"
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_API_KEY="ollama"
OLLAMA_MODEL_DEFAULT="llama3.1:8b-instruct-q8_0"

# --- Storage ---
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="buildx"

# --- Optional live research (agents fall back to model knowledge without these) ---
TAVILY_API_KEY=""
SERPER_API_KEY=""

# --- Autonomy ---
AUTOPILOT_ENABLED=true
AUTOPILOT_SWEEP_SECONDS=60
MAX_REVISION_CYCLES=3

# --- Observability ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="MIDAS"
